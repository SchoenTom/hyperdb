# ── Secrets (NEVER commit) ──────────────────────────────────────────────
# Real config holds the EODHD API token. Track config/settings.example.yaml instead.
config/settings.yaml
*.token
.env

# ── Database files (too large for git) ──────────────────────────────────
*.duckdb
*.duckdb.wal
*.duckdb.tmp/
*.db
*.sqlite
*.sqlite3

# ── Raw / downloaded data & manifests (live on the external drive) ───────
data/
manifests/
*.parquet
*.feather

# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# ── IDE ─────────────────────────────────────────────────────────────────
.idea/
.vscode/

# ── OS ──────────────────────────────────────────────────────────────────
.DS_Store
._*
.Spotlight-V100/
.fseventsd/
.Trashes/

# ── Logs & temp ─────────────────────────────────────────────────────────
reports/hyperdb.log
*.log
duckdb_temp/
